  "journal": {
    "identity": "This manuscript is a variant-effect predictor calibration paper (AM vs transporter abundance DMS, SPT as a structural prior), not a PGx discovery paper.",
    "submit_to": [
      "PLOS Computational Biology",
      "Human Genomics"
    ],
    "do_not_insist_on": "The Pharmacogenomics Journal / CPT / similar PGx venues as first target after a 2-week second-transporter attempt",
